# Copy this file to .env and fill values ONLY on your own machine.
# Never commit .env or real API keys.
NODE_ENV=development
PORT=3010

# Choose deepseek, gemini, or openai.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: Google Cloud Text-to-Speech only.
# Leave empty for text-only conversations. Alibaba TTS is not integrated.
TTS_API_KEY=
